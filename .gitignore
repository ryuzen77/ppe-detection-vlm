# Environment variables & secrets (Server-side API keys)
.env
backend/.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/__pycache__/

# Model weights (Downloaded automatically by Ultralytics to prevent repo bloat)
*.pt
backend/*.pt

# OS & Temp files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*.log

# Data runtime (audit, foto bukti, pilihan operator) - DATA_DIR bawaan
data/

# Lokasi data lama sebelum T12; dipindah otomatis ke DATA_DIR saat server jalan
backend/camera_state.json
backend/runtime_settings.json
backend/reports/
