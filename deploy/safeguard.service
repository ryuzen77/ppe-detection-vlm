# Unit systemd SAFEGUARD AI: menyala otomatis saat boot, bangkit ulang bila mati.
#
# Pasang (sesuaikan User dan jalur, lalu):
#   sudo cp deploy/safeguard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now safeguard
# Pantau:  systemctl status safeguard   |   journalctl -u safeguard -f
#
# Konfigurasi tetap dari backend/.env. Untuk produksi, arahkan DATA_DIR ke
# jalur absolut di luar repo (mis. /var/lib/safeguard) agar data tidak ikut
# terhapus bersama repo.

[Unit]
Description=SAFEGUARD AI - gerbang pemeriksaan APD
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=safeguard
# Grup video: akses /dev/videoN; audio: pengumuman suara; dialout: lampu serial
SupplementaryGroups=video audio dialout
WorkingDirectory=/opt/safeguard
Environment=SAFEGUARD_VENV=/opt/safeguard/.venv
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/safeguard/start_system.sh
Restart=on-failure
RestartSec=5
# Server menutup kamera, lampu, dan audit sendiri saat menerima SIGTERM
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
