# ==========================================
# PPE Detection VLM - Server-side Environment
# ==========================================

# Google Gemini API Key (Dibiarkan kosong jika ingin menggunakan mode simulasi/mock)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Camera Settings (0 = Default Webcam / USB Camera)
CAMERA_INDEX=0

# Server Port
HOST=0.0.0.0
PORT=8000

# IoT Hardware Stage 2 (Opsional / Siap Pakai)
IOT_ENABLED=false
IOT_TYPE=serial
IOT_SERIAL_PORT=COM3
IOT_SERIAL_BAUD=9600
