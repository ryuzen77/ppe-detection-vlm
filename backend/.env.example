# ==========================================
# PPE Detection VLM - Server-side Environment
# ==========================================

# --- VLM (penilai APD) ---
# Cukup pilih PENYEDIA + MODEL + KEY; alamat bawaan, model bawaan, lokal/cloud, dan cara
# mengatur mode berpikir diambil dari katalog backend/vlm_providers/profiles.py (T39b).
#
# Penyedia resmi (sudah diuji di gerbang ini):
#   gemini  (cloud, butuh key)   model bawaan gemini-3.5-flash-lite
#   ollama  (lokal, tanpa key)   model bawaan qwen2.5vl:7b  (unduh: ollama pull qwen2.5vl:7b)
# Eksperimental (adaptor ada, belum diuji di sini; server memberi peringatan):
#   openrouter | qwen | deepseek | openai | kimi | anthropic | vllm | openai-compatible
#   -> VLM_MODEL wajib diisi
#
# Model yang belum ada di daftar tervalidasi (profiles.VALIDATIONS) tetap boleh dipakai,
# tetapi diberi peringatan di log: uji dulu dengan tools/bench_vlm.py (syarat: 0 APD kurang lolos).
#
# Contoh:
#   cloud Gemini        : VLM_PROVIDER=gemini      GEMINI_API_KEY=<key>
#   tanpa internet      : VLM_PROVIDER=ollama      (VLM_BACKUP_PROVIDER otomatis none)
#   OpenRouter          : VLM_PROVIDER=openrouter  VLM_MODEL=qwen/qwen2.5-vl-72b-instruct  OPENROUTER_API_KEY=<key>
#   server sendiri      : VLM_PROVIDER=vllm        VLM_BASE_URL=http://host:port/v1  VLM_MODEL=<model>
#
# Pengaturan admin di dashboard bisa mengganti penyedia/model utama & cadangan tanpa
# restart (T28). Pilihan itu disimpan di DATA_DIR/runtime_settings.json dan MENANG atas
# VLM_PROVIDER/VLM_MODEL di bawah; tombol "kembali ke .env" menghapusnya. Dashboard tidak
# pernah menerima API key: key hanya ditulis di berkas ini.
VLM_PROVIDER=gemini

# --- API key per penyedia (T28) ---
# Isi key penyedia yang ingin bisa dipilih dari dashboard. Key satu penyedia tidak
# pernah dikirim ke penyedia lain. Penyedia lokal (ollama, vllm) tanpa key.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Qwen (Alibaba DashScope)
DASHSCOPE_API_KEY=
# Kimi (Moonshot)
MOONSHOT_API_KEY=
# Claude (Anthropic)
ANTHROPIC_API_KEY=
# Batas token jawaban Claude (model Claude terbaru berpikir dulu; pikirannya ikut dihitung)
VLM_ANTHROPIC_MAX_TOKENS=4096

# Key utama untuk VLM_PROVIDER saja (cara lama, tetap didukung). Bila diisi, menang
# atas key per penyedia di atas. Kosong untuk penyedia cloud tanpa key per penyedia =
# utama nonaktif; gerbang memakai cadangan saja.
VLM_API_KEY=
# Model yang MENERIMA GAMBAR. Kosong = model bawaan profil penyedia.
VLM_MODEL=
# Alamat server OpenAI-compatible. Kosong = alamat bawaan profil. Wajib untuk vllm dan
# openai-compatible.
VLM_BASE_URL=
# Mode "berpikir" model: off | low | medium | high (semua penyedia; diabaikan dengan
# peringatan bila penyedia tidak bisa mengaturnya). off tercepat: Gemini ~1,4 dtk vs ~5 dtk,
# jawaban APD sama. Nama lama GEMINI_THINKING_LEVEL tetap dibaca.
VLM_THINKING=off
# Jeda minimum antar panggilan ke VLM cloud (menjaga kuota free tier, 15 RPM).
# VLM lokal tanpa jeda. Kosong = 4 dtk.
VLM_MIN_INTERVAL_SECONDS=

# --- VLM cadangan (otomatis saat utama gagal) ---
# Bila utama galat, lambat, atau jawabannya rusak, pekerja yang SAMA langsung
# diperiksa cadangan. Kosong = ollama bila utama cloud; none = tanpa cadangan.
# Utama sudah lokal (lokasi tanpa internet) = tanpa cadangan bawaan.
VLM_BACKUP_PROVIDER=
# Kosong = model bawaan profil penyedia cadangan (ollama -> qwen2.5vl:7b).
VLM_BACKUP_MODEL=
VLM_BACKUP_BASE_URL=
# Kosong = key per penyedia cadangan (mis. DEEPSEEK_API_KEY) dari bagian di atas
VLM_BACKUP_API_KEY=
# Batas waktu satu panggilan. Cloud pendek agar cepat dialihkan ke cadangan;
# lokal longgar (qwen2.5vl:7b p95 9,2 dtk). Terburuk saat utama gagal ~4 + 12 dtk.
VLM_CLOUD_TIMEOUT_SECONDS=4
VLM_LOCAL_TIMEOUT_SECONDS=12
# Setelah sekian kegagalan berturut-turut utama dianggap terputus dan dilewati,
# lalu dicoba lagi pada pekerja nyata setelah jeda (tanpa panggilan uji berkala
# yang menghabiskan kuota harian).
VLM_PRIMARY_FAILURES_BEFORE_DOWN=2
VLM_PRIMARY_RETRY_AFTER_SECONDS=60
# Utama & cadangan gagal: pekerja TIDAK diloloskan maupun ditolak, melainkan
# diminta menunggu lewat suara; bila masih di jalur, diperiksa ulang setelah jeda ini.
VLM_SYSTEM_RETRY_SECONDS=15
# Selang pemeriksaan porsi GPU VLM lokal (Ollama); model dimuat ulang bila sebagian jatuh ke CPU (T38)
LOCAL_GPU_CHECK_SECONDS=60
# Kesehatan VLM lokal (T56): sekian panggilan berturut-turut di atas LOCAL_SLOW_SECONDS
# (atau habis waktu) = "lambat" → peringatan + model dimuat ulang. Sering terjadi bila
# aplikasi lain memakai GPU NVIDIA (VRAM 8 GB nyaris penuh oleh model + YOLO).
LOCAL_SLOW_SECONDS=8
LOCAL_SLOW_STREAK=2
# Versi Ollama tempat model lokal divalidasi; versi lain = peringatan saat start (T29).
# Matikan update otomatis di aplikasi Ollama supaya versinya tidak berubah diam-diam.
OLLAMA_VALIDATED_VERSION=0.34.4
# Suhu sampling VLM (semua penyedia). Rendah = jawaban konsisten untuk foto yang sama.
VLM_TEMPERATURE=0.1
# Nama lama GEMINI_MODEL tetap dibaca bila VLM_PROVIDER=gemini dan VLM_MODEL kosong,
# jadi .env lama tidak perlu diubah (GEMINI_API_KEY kini key per penyedia di atas).

# Server & Network Settings
HOST=0.0.0.0
PORT=8000
# Daftar origin dipisah koma. Hindari "*" jika butuh credentials (ditolak browser).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Login dashboard memakai AKUN (T51), bukan lagi ADMIN_TOKEN. Saat belum ada akun, buka
# http://localhost:8000 DI MESIN GERBANG untuk membuat admin pertama (dari komputer lain
# ditolak). Lupa kata sandi: python -m backend.accounts reset-password <nama>.
# ADMIN_TOKEN & ALLOW_INSECURE_DEMO lama tidak dipakai lagi; hapus dari .env.
# Lama sesi login dashboard dalam jam (T30); setelah itu login ulang
SESSION_HOURS=8
# Batas muatan POST (anti DoS), bawaan 1MB
MAX_PAYLOAD_BYTES=1048576

# Direktori data runtime: audit.db, foto bukti, pilihan kamera, dan item APD aktif.
# Kosong = folder data/ di akar repo. Untuk produksi, isi jalur absolut di luar
# repo (mis. C:\ProgramData\DEPRO) agar deploy ulang tidak menyentuh data.
# Jalur relatif dihitung dari akar repo. Data lama di backend/ dipindah otomatis
# saat server pertama kali dijalankan.
DATA_DIR=

# --- Identitas wajah pekerja (T34) ---
# Kunci enkripsi templat wajah (AES-256, base64 32 byte). Kosong = pengenalan wajah mati,
# gerbang tetap berjalan tanpa nama. Buat di mesin gerbang lalu salin barisnya ke sini:
#   python -m backend.face_crypto generate-key
# Simpan cadangan kunci di tempat aman (bukan di folder data/): kunci hilang = semua pekerja
# didaftarkan ulang. Jangan pernah dikirim lewat chat/email atau di-commit.
FACE_DATA_KEY=
# Templat wajah dihapus otomatis sekian hari setelah pekerja dinonaktifkan
FACE_RETENTION_DAYS=30
# Versi formulir persetujuan tertulis (dari HR/Legal) yang dicentang admin saat mendaftar
FACE_CONSENT_VERSION=1

# Log (T53), semua di DATA_DIR/logs:
# - application log: konsol + safeguard.log (jalannya sistem, galat);
# - security log: security.jsonl (login, penguncian, akses ditolak, perubahan akun, ganti VLM);
# - audit inspeksi tetap di reports/audit.db (lihat RETENTION_* di bawah).
# Tiap berkas berotasi LOG_MAX_BYTES x LOG_BACKUP_COUNT; salinan lama dihapus
# setelah LOG_RETENTION_DAYS / SECURITY_LOG_RETENTION_DAYS (0 = tanpa batas umur).
# LOG_LEVEL: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_RETENTION_DAYS=30
SECURITY_LOG_RETENTION_DAYS=90
# Pesan yang sama persis dicatat sekali per jendela ini (detik), lalu "terulang N kali"
LOG_REPEAT_WINDOW_SECONDS=60
# Log akses HTTP rutin (polling dashboard); WARNING = hanya yang bermasalah
LOG_ACCESS_LEVEL=WARNING
# Penjaga disk: sisa ruang DATA_DIR di bawah batas (GB) → log berkas dikurangi (WARN)
# atau dihentikan (CRITICAL) supaya audit & foto bukti tetap bisa disimpan
DISK_WARN_FREE_GB=5
DISK_CRITICAL_FREE_GB=1
DISK_CHECK_SECONDS=60

# Bobot YOLO untuk deteksi orang + pose. Wajib model *-pose: gerbang full-body
# memakai keypoint kepala, lutut, dan pergelangan kaki. Jalur relatif dihitung
# dari backend/, jalur absolut juga diterima. Bila berkasnya belum ada dan
# namanya bobot resmi Ultralytics, berkas diunduh otomatis saat server menyala.
YOLO_MODEL_PATH=yolo26s-pose.pt

# Camera Settings (0 = Default Webcam / USB Camera)
# Dipakai hanya saat belum ada pilihan tersimpan di DATA_DIR/camera_state.json.
CAMERA_INDEX=0

# true  : kamera dibuka dengan permintaan bawaan yang terbukti lancar di berbagai
#         perangkat; mode terbaik dicari lewat tombol "Pindai kamera" di dashboard
#         dan hasilnya disimpan di DATA_DIR/camera_state.json.
# false : paksa FRAME_WIDTH/FRAME_HEIGHT di bawah (mis. jika ketelitian VLM lebih
#         penting daripada kelancaran video).
# Kamera TIDAK dibuka saat server menyala. Operator memilih sumbernya dari
# dashboard lebih dulu, baru video tersambung. Set true hanya jika sistem harus
# langsung menyala sendiri memakai kamera terakhir (mis. kios tanpa operator).
CAMERA_AUTOSTART=false
# Kamera yang dibuka otomatis, dipilih LEWAT NAMA (lihat daftar di dashboard), mis.
# CAMERA_NAME=HD Pro Webcam C920. Kosong = pilihan terakhir operator. Bila kamera itu belum
# terlihat sistem, gerbang menunggu (lampu kuning) — tidak pernah membuka kamera lain.
CAMERA_NAME=

CAMERA_AUTO_MODE=true
# Gangguan kamera (T45): gerbang berhenti memeriksa & lampu kuning bila gambar
# tertutup/gelap (kecerahan rata-rata 0-255 < DARK atau > BRIGHT, atau nyaris seragam)
# atau membeku (frame identik) selama sekian detik. Gelap: naikkan lampu area, bukan ambang.
CAMERA_DARK_MEAN=25
CAMERA_BRIGHT_MEAN=235
CAMERA_UNIFORM_STD=6
# Buram/terhalang benda (T57): dianggap tertutup bila ketajaman < MIN_SHARPNESS DAN porsi
# tepi < MIN_EDGE_RATIO. Salah alarm saat jalur kosong? ukur dulu: python tools/camera_probe.py
CAMERA_MIN_SHARPNESS=80
CAMERA_MIN_EDGE_RATIO=0.01
CAMERA_BLOCKED_SECONDS=1.5
CAMERA_FROZEN_SECONDS=3.0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FPS=30

# Overlay HUD sisi server. Biarkan false: koridor & bounding box sudah digambar
# canvas frontend, menyalakannya menghasilkan overlay ganda.
ENABLE_SERVER_HUD=false

# Workflow & Timing Settings
# Detik jalur inspeksi harus kosong sebelum pekerja berikutnya diperiksa.
# Selama pekerja masih di jalur, keputusan (hijau/merah) terkunci. 1,5 sejak T36c
# (sebelumnya 3,0): jeda ini menahan antrean tiap pekerja.
STANDBY_RESET_DELAY_SECONDS=1.5
# Detik keputusan LOLOS per ID pelacak diingat setelah sesi berakhir: orang yang
# lolos lalu terlihat lagi dengan ID sama tidak diperiksa ulang (yang ditolak selalu
# diperiksa ulang).
DECIDED_TRACK_MEMORY_SECONDS=10
# Jumlah frame tubuh-utuh berturut-turut yang dikumpulkan sebelum analisa; satu frame
# terbaik (paling tajam, paling diam, pose paling jelas) yang dikirim ke VLM.
# Tiap frame tambahan menambah ~35-50 ms sebelum analisa dimulai.
STABLE_FRAMES_REQUIRED=3
# Pekerja dipotret hanya setelah tubuh utuh, menghadap kamera, dan diam selama ini (T46)
READY_HOLD_SECONDS=1.0
# Batas "diam": pergeseran tubuh relatif tinggi tubuh terhadap awal jendela (0.05 = 5%)
READY_MAX_DRIFT=0.05
# Kedua bahu harus terlihat sebelum dipotret (pekerja tidak menyamping)
READY_REQUIRE_SHOULDERS=true
MAX_HISTORY_RECORDS=30

# Lampu gerbang fisik (lihat IOT_HARDWARE_SPEC.md)
IOT_ENABLED=false
# "serial"    = ESP32 DevKit V1 lewat kabel USB (merah/kuning/hijau, heartbeat) — rancangan utama
# "usb_relay" = relay USB HID dcttech USBRelay2 (hijau & merah saja) — KHUSUS DEMO
# Wi-Fi/HTTP dibuang karena bisa dipalsukan di jaringan.
IOT_TYPE=serial
# Port ESP32: Windows "COM3" dsb. (Device Manager), Linux "/dev/ttyUSB0"
IOT_SERIAL_PORT=COM3
# Relay USB: kanal tiap lampu (1-based). Kabel lampu ke kontak NO supaya lampu
# mati saat relay tidak aktif / tanpa daya. Serial kosong = papan pertama.
IOT_RELAY_GREEN_CHANNEL=1
IOT_RELAY_RED_CHANNEL=2
IOT_RELAY_SERIAL=

# --- RETENSI DATA ---
RETENTION_PHOTO_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_MAX_PHOTO_GB=2.0
RETENTION_INTERVAL_HOURS=24

# --- ZONA TITIK BERDIRI (T36d) ---
# Pita zona diatur/dikalibrasi dari tab Pengaturan (tersimpan di data/runtime_settings.json).
# Toleransi atas-bawah saat kalibrasi, relatif tinggi gambar (0,06 ≈ ±25-35 cm pada jarak 2-3 m)
ZONE_CALIBRATE_MARGIN=0.06
# Detik posisi kaki terakhir yang jelas dipakai saat pergelangan kaki tertutup orang lain
FOOT_MEMORY_SECONDS=2.0
