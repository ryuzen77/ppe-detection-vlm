# ==========================================
# PPE Detection VLM - Server-side Environment
# ==========================================

# Google Gemini API Key (Dibiarkan kosong jika ingin menggunakan mode simulasi/mock)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server & Network Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Camera Settings (0 = Default Webcam / USB Camera)
CAMERA_INDEX=0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FPS=30

# Workflow & Timing Settings
TRACK_TIMEOUT_SECONDS=15.0
STANDBY_RESET_DELAY_SECONDS=4.0
MAX_HISTORY_RECORDS=30

# IoT Hardware Stage 2 (ESP32 Wireless Wi-Fi / Arduino Serial)
IOT_ENABLED=false
# Pilihan IOT_TYPE: "http" (ESP32 Wi-Fi Tanpa Kabel) atau "serial" (Kabel USB)
IOT_TYPE=http
# Jika IOT_TYPE=http (ESP32 DevKit V1 Wireless):
IOT_HTTP_URL=http://gate-k3.local
# Jika IOT_TYPE=serial (Arduino USB Serial):
IOT_SERIAL_PORT=COM3
IOT_SERIAL_BAUD=9600
